{
  "openapi": "3.0.3",
  "info": {
    "title": "Maps",
    "version": "0.1.1"
  },
  "paths": {
    "/api/state": {
      "get": {
        "summary": "Regions, world map, engines, lists and saved places in one read",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Search places as you type (Photon) plus matching saved places",
        "responses": {
          "200": {
            "description": "{query,results,saved}"
          },
          "503": {
            "description": "Search not ready"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/reverse": {
      "get": {
        "summary": "Nearest address or place at a point",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ]
      }
    },
    "/api/route": {
      "post": {
        "summary": "Directions: car, motorbike, bike, walk (Valhalla) or transit (MOTIS)",
        "responses": {
          "200": {
            "description": "{mode,from,to,routes,note}"
          },
          "404": {
            "description": "No route"
          },
          "503": {
            "description": "Not ready"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  },
                  "depart_at": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/places": {
      "get": {
        "summary": "Saved places",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "list",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Save a place (idempotent by id)",
        "responses": {
          "201": {
            "description": "{place}"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "address": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "list": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/places/{id}": {
      "post": {
        "summary": "Change name, note or list of a saved place",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "list": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/places/{id}/delete": {
      "post": {
        "summary": "Delete a saved place",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/lists": {
      "get": {
        "summary": "Lists with counts",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Create a list",
        "responses": {
          "201": {
            "description": "{list}"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/regions": {
      "get": {
        "summary": "Regions on the server and build progress",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Add a region (background build)",
        "responses": {
          "202": {
            "description": "{region,state}"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/regions/catalog": {
      "get": {
        "summary": "Find downloadable regions (Geofabrik) by name or point",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ]
      }
    },
    "/api/regions/{id}/refresh": {
      "post": {
        "summary": "Rebuild a region now",
        "responses": {
          "202": {
            "description": "queued"
          }
        }
      }
    },
    "/api/regions/{id}/remove": {
      "post": {
        "summary": "Remove a region and its data",
        "responses": {
          "202": {
            "description": "removed"
          }
        }
      }
    },
    "/api/packs": {
      "get": {
        "summary": "Offline map packs being cut for the phone",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Cut an offline map pack for a bbox",
        "responses": {
          "202": {
            "description": "{pack}"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "bbox": {
                    "type": "string"
                  },
                  "maxzoom": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/packs/estimate": {
      "get": {
        "summary": "Size estimate of an offline pack",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxzoom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/tiles/{name}.pmtiles": {
      "get": {
        "summary": "PMTiles archive (world or a region) with HTTP Range",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}